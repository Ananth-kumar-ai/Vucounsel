<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_margin="20dp"
    android:background="@drawable/nav_bg"
    android:backgroundTint="@color/secondary"
    android:elevation="8dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    >

    <!-- Marks Item -->
    <LinearLayout
        android:id="@+id/marks_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/nav_item_bg"
        android:padding="8dp">

        <ImageView
            android:id="@+id/marks_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Marks"
            android:src="@drawable/marks" />

        <TextView
            android:id="@+id/marks_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:alpha="0"
            android:text="Marks"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Home Item -->
    <LinearLayout
        android:id="@+id/home_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/nav_item_bg"
        android:padding="8dp">

        <ImageView
            android:id="@+id/home_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Home"
            android:src="@drawable/home" />

        <TextView
            android:id="@+id/home_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:alpha="0"
            android:text="Home"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Feedback Item -->
    <LinearLayout
        android:id="@+id/feedback_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/nav_item_bg"
        android:padding="8dp">

        <ImageView
            android:id="@+id/feedback_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Feedback"
            android:src="@drawable/feedback" />

        <TextView
            android:id="@+id/feedback_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:alpha="0"
            android:text="Reports"
            android:textSize="13sp"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>