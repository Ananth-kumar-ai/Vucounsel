<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#192BC2"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:paddingTop="36dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/back_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student Report"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/header_regno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reg No: —"
                    android:textColor="#B3B9F2"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Module selector chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/chip_m1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:text="Module 1"
                android:gravity="center"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/chip_selected"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chip_m2"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:text="Module 2"
                android:gravity="center"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#B3B9F2"
                android:background="@drawable/chip_unselected"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Loading State -->
            <LinearLayout
                android:id="@+id/loading_layout"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <ProgressBar
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:indeterminateTint="#192BC2"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Retrieving full report..."
                    android:textColor="#5A6B8B"
                    android:textSize="15sp"
                    android:layout_marginTop="16dp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Main content -->
            <LinearLayout
                android:id="@+id/content_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- ===== SECTION 1: COUNSELLING REPORT ===== -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:elevation="0dp"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="16dp"
                    android:backgroundTint="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Section Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="16dp"
                            android:background="#2E7D32">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Counselling Summary"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/counselling_date_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:background="@drawable/badge_white_alpha"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"/>
                        </LinearLayout>

                        <!-- Week navigator -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:background="#E8F5E9">

                            <TextView
                                android:id="@+id/btn_prev_week"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:text="&#8249;"
                                android:textSize="24sp"
                                android:textColor="#2E7D32"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true"/>

                            <TextView
                                android:id="@+id/week_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Loading..."
                                android:textColor="#1B5E20"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:singleLine="true"/>

                            <TextView
                                android:id="@+id/btn_next_week"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:text="&#8250;"
                                android:textSize="24sp"
                                android:textColor="#2E7D32"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true"/>
                        </LinearLayout>

                        <!-- Dynamic counselling container -->
                        <LinearLayout
                            android:id="@+id/counselling_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ===== SECTION 2: APPRAISAL TRAITS REPORT ===== -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:elevation="0dp"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="16dp"
                    android:backgroundTint="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="16dp"
                            android:background="#00838F">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Behavioral Traits"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- Dynamic traits container -->
                        <LinearLayout
                            android:id="@+id/traits_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>


                <!-- ===== SECTION 3: ATTITUDE REPORT ===== -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:elevation="0dp"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="16dp"
                    android:backgroundTint="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="16dp"
                            android:background="#D84315">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Attitude Record"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- Dynamic attitude container -->
                        <LinearLayout
                            android:id="@+id/attitude_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/empty_layout"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝"
                    android:textSize="56sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data Unavailable"
                    android:textColor="#455A64"
                    android:textSize="18sp"
                    android:layout_marginTop="16dp"
                    android:textStyle="bold"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No records found for the selected module"
                    android:textColor="#78909C"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>