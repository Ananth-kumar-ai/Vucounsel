<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10sp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="15dp"
            app:cardCornerRadius="10dp"
            android:layout_margin="10dp"
            android:id="@+id/sem_card"
            android:backgroundTint="#EAEEFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/acadperf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="6.50dp"
                    android:text="Attendance (in hrs)"
                    android:textSize="18.20dp"
                    android:textStyle="bold"/>

                <View
                    android:id="@+id/v"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_margin="6.50dp"
                    android:background="@color/black"
                    app:layout_constraintEnd_toEndOf="@+id/acadperf"
                    app:layout_constraintStart_toStartOf="@id/acadperf"
                    app:layout_constraintTop_toBottomOf="@+id/acadperf" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="10dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="80sp"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Total Periods"
                            android:gravity="center"
                            android:textSize="10dp"
                            />
                        <TextView
                            android:id="@+id/total"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="O"
                            android:textSize="30sp"
                            android:gravity="center"
                            android:textAlignment="center"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="80sp"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Absent Periods"
                            android:gravity="center"
                            android:textSize="10dp"
                            />
                        <TextView
                            android:id="@+id/absent"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="O"
                            android:textSize="30sp"
                            android:gravity="center"
                            android:textAlignment="center"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="80sp"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Present"
                            android:gravity="center"
                            android:textSize="10dp"
                            />
                        <TextView
                            android:id="@+id/present"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="O"
                            android:textSize="30sp"
                            android:gravity="center"
                            android:textAlignment="center"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="80sp"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Percentage"
                            android:gravity="center"
                            android:textSize="10dp"
                            />
                        <TextView
                            android:id="@+id/percentage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="O"
                            android:textSize="30sp"
                            android:gravity="center"
                            android:textAlignment="center"/>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>